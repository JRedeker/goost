{
  "name": "goost-status",
  "version": "1.0.0",
  "description": "Contract-aware status plugin for Goost - shows sub-agent and completion state in terminal tab",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "opencode",
    "plugin",
    "goost",
    "wsl",
    "terminal",
    "status",
    "contract"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "bun-types": "latest",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.18.2"
  }
}
